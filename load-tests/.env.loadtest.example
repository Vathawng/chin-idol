# Copy to load-tests/.env.loadtest and fill in. This file holds SECRETS
# (service role key, Stripe TEST webhook secret) — .env.loadtest is git-ignored.
# Use STAGING / TEST credentials only. Never point this at production.

# The deployed app under test (Vercel/Next). No trailing slash.
BASE_URL=https://chin-idol.vercel.app

# Supabase (staging project) — Project Settings → API.
# Used only by the setup scripts (read contestants/round) and the results
# scenario (read the vote-totals view). Voting itself is anonymous.
LT_SUPABASE_URL=https://YOUR-REF.supabase.co
LT_SUPABASE_ANON_KEY=your-anon-key
LT_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe TEST webhook signing secret (whsec_...) for the target deploy's
# /api/webhooks/stripe endpoint. Only used to run the ingestion scenario.
LT_STRIPE_WEBHOOK_SECRET=whsec_your_test_secret

# Intensity knobs (also overridable per-run with -e on the k6 CLI)
VUS=20
DURATION=1m
CHECKOUT_RPS=8
CHECKOUT_DURATION=1m
WEBHOOK_RPS=50
WEBHOOK_DURATION=2m
